modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
BOOTSTRAP_ADMIN_USER_ID = "user_3Fy2L7ExgEkwbAVv4bE2BCPZiF1"
INBOUND_REPLY_DOMAIN = "sdrai.xyz"

[userenv.development]
INBOUND_REPLY_DOMAIN = "sdrai.xyz"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18443
externalPort = 3003

[[ports]]
localPort = 18963
externalPort = 3002

[[ports]]
localPort = 21053
externalPort = 3000

[[ports]]
localPort = 25069
externalPort = 3001
