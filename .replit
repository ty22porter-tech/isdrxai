modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
BOOTSTRAP_ADMIN_USER_ID = "user_3Fy2L7ExgEkwbAVv4bE2BCPZiF1"
INBOUND_REPLY_DOMAIN = "sdrai.xyz"

[userenv.development]
INBOUND_REPLY_DOMAIN = "sdrai.xyz"

[userenv.shared]
PUBLIC_APP_URL = "https://iSDRXAI.replit.app"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18443
externalPort = 80

[[ports]]
localPort = 18963
externalPort = 3000

[[ports]]
localPort = 21053
externalPort = 3002

[[ports]]
localPort = 25069
externalPort = 3001

[objectStorage]
defaultBucketID = "replit-objstore-e538950f-df92-482b-a57f-9a5590cdad6e"
